---
// Página de cada artigo (rota /artigos/<id>, onde <id> é o nome do arquivo .md).
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, PESSOA } from '../../config';
import { artigosPublicados, formatarData, tempoDeLeitura, type Artigo } from '../../lib/artigos';

export async function getStaticPaths() {
  const artigos = await artigosPublicados();
  return artigos.map((artigo) => ({ params: { id: artigo.id }, props: { artigo } }));
}

const { artigo } = Astro.props as { artigo: Artigo };
const { Content } = await render(artigo);
const { titulo, resumo, data, linkedin, fonte, tags } = artigo.data;
const tagPrincipal = tags[0] ?? '';
const dataIso = data.toISOString().slice(0, 10);
const url = `${SITE.url}/artigos/${artigo.id}/`;

// Dados estruturados do artigo (schema.org/Article), com o artigo comentado em isBasedOn.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titulo,
  description: resumo,
  datePublished: dataIso,
  inLanguage: 'pt-BR',
  url,
  mainEntityOfPage: url,
  image: `${SITE.url}${SITE.ogImagem}`,
  keywords: tags.join(', '),
  author: { '@type': 'Person', '@id': PESSOA['@id'], name: PESSOA.name, url: PESSOA.url },
  ...(fonte && {
    isBasedOn: { '@type': 'CreativeWork', name: fonte.titulo, url: fonte.url, inLanguage: fonte.idioma },
  }),
  sameAs: linkedin,
};
---
<Base titulo={`${titulo} | Maximiliano Ferreira`} descricao={resumo} ogTipo="article" publicadoEm={dataIso} schema={schema}>
  <main class="container">
    <article class="markdown-body artigo" data-artigo-slug={artigo.id} data-artigo-tag={tagPrincipal}>
      <p class="artigo-meta">
        <a href="/artigos/">← Artigos</a>
        {' · '}
        <time datetime={data.toISOString().slice(0, 10)}>{formatarData(data)}</time>
        {' · '}
        {tempoDeLeitura(artigo.body)} min de leitura
      </p>

      <h1>{titulo}</h1>

      <Content />

      {
        fonte && (
          <p class="artigo-fonte">
            Artigo comentado: <a href={fonte.url} rel="noopener">{fonte.titulo}</a>, de {fonte.autor}
            {fonte.idioma === 'en' ? ' (em inglês)' : ''}.
          </p>
        )
      }

      <p class="artigo-origem">
        Publicado originalmente no
        <a href={linkedin} rel="noopener" data-artigo-linkedin>LinkedIn</a>.
      </p>

      <p class="artigo-tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </p>
    </article>
  </main>

  <script is:inline>
    // Eventos de leitura (contrato em docs/data-layer.md).
    (function () {
      var artigo = document.querySelector('[data-artigo-slug]');
      if (!artigo) return;
      var slug = artigo.getAttribute('data-artigo-slug');
      var tag = artigo.getAttribute('data-artigo-tag');
      window.dataLayer = window.dataLayer || [];

      // artigo_ler: leitura real, uma vez por página. Três condições ao mesmo tempo:
      // 1) o leitor rolou a página (dispensado se o artigo inteiro cabe na tela);
      // 2) 75% do texto do artigo já passou pela tela;
      // 3) pelo menos 10 s desde a abertura (abrir e sair não conta como leitura).
      var TEMPO_MINIMO_MS = 10000;
      var inicio = Date.now();
      var rolou = false;
      var enviado = false;
      var agendado = false;

      function paginaRola() {
        return document.documentElement.scrollHeight > window.innerHeight + 1;
      }

      function verificarLeitura() {
        if (enviado) return;
        if (paginaRola() && !rolou) return;
        var r = artigo.getBoundingClientRect();
        var lido = (window.innerHeight - r.top) / r.height;
        if (lido < 0.75) return;
        var falta = TEMPO_MINIMO_MS - (Date.now() - inicio);
        if (falta > 0) {
          // Chegou cedo demais: confere de novo quando completar o tempo mínimo.
          if (!agendado) {
            agendado = true;
            setTimeout(function () {
              agendado = false;
              verificarLeitura();
            }, falta);
          }
          return;
        }
        enviado = true;
        window.dataLayer.push({ event: 'artigo_ler', artigo_slug: slug, artigo_tag: tag });
        window.removeEventListener('scroll', aoRolar);
        window.removeEventListener('resize', verificarLeitura);
      }

      function aoRolar() {
        if (window.scrollY > 0) rolou = true;
        verificarLeitura();
      }

      window.addEventListener('scroll', aoRolar, { passive: true });
      window.addEventListener('resize', verificarLeitura);
      // Artigo que cabe inteiro na tela não tem rolagem: conta após o tempo mínimo.
      setTimeout(verificarLeitura, TEMPO_MINIMO_MS);

      // artigo_linkedin_clicar: clique no link do post original.
      var link = document.querySelector('[data-artigo-linkedin]');
      if (link) {
        link.addEventListener('click', function () {
          window.dataLayer.push({ event: 'artigo_linkedin_clicar', artigo_slug: slug });
        });
      }
    })();
  </script>
</Base>
