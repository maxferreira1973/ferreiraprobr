---
// Página do currículo (rota /).
// O conteúdo vem de src/data/curriculo.md e é convertido em HTML durante o build,
// então buscadores, ATS e prévias de link recebem o currículo completo.
import Base from '../layouts/Base.astro';
import { Content } from '../data/curriculo.md';
---
<Base>
  <!-- O botão vai para o cabeçalho fixo, então continua à mão durante a rolagem -->
  <button slot="acoes" id="exportPdfBtn" class="btn-exportar btn-cabecalho" type="button">Exportar PDF</button>

  <main class="container">
    <article id="conteudo" class="markdown-body">
      <Content />
    </article>
  </main>

  <script is:inline>
    // Exportar PDF = impressão do navegador (o CSS @media print ajusta o layout).
    // Antes de abrir a impressão, registra o evento de conversão no dataLayer.
    // Contrato do evento: docs/data-layer.md
    document.getElementById('exportPdfBtn').addEventListener('click', function () {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'curriculo_exportar',
        metodo: 'impressao',
        posicao: 'topo',
      });
      window.print();
    });

    // "Fale comigo": o endereço de e-mail só é montado no clique,
    // para não ficar escrito no HTML (onde robôs de spam o coletariam).
    var fale = document.getElementById('fale-comigo');
    if (fale) {
      fale.addEventListener('click', function (e) {
        e.preventDefault();
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'contato_clicar', canal: 'email' });
        window.location.href = 'mailto:' + fale.dataset.u + '@' + fale.dataset.d;
      });
    }
  </script>
</Base>
