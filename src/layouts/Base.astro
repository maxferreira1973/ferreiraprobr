---
// Layout base: tudo que se repete em todas as páginas (cabeçalho HTML, GTM, estilos).
import '../styles/global.css';
import { SITE, GTM_ID } from '../config';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  titulo?: string;
  descricao?: string;
  // "website" (padrão) ou "article" (páginas de artigo)
  ogTipo?: 'website' | 'article';
  // Data de publicação (só para artigos), no formato AAAA-MM-DD
  publicadoEm?: string;
  // Dados estruturados (JSON-LD) da página: ajudam o Google e as buscas com IA a entender o conteúdo
  schema?: Record<string, unknown>;
}

const {
  titulo = SITE.titulo,
  descricao = SITE.descricao,
  ogTipo = 'website',
  publicadoEm,
  schema,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImagem = new URL(SITE.ogImagem, SITE.url).href;
const secao = Astro.url.pathname.startsWith('/artigos')
  ? 'artigos'
  : Astro.url.pathname === '/'
    ? 'curriculo'
    : '';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />

    <!-- Prévia de link (LinkedIn, WhatsApp etc.) -->
    <meta property="og:type" content={ogTipo} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Maximiliano Ferreira, Web Analytics Sênior" />
    {publicadoEm && <meta property="article:published_time" content={publicadoEm} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Ícones da aba do navegador e da tela inicial do celular -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!--
      Consent Mode v2 (modo avançado): precisa rodar ANTES do GTM.
      Tudo começa negado. O site não tem anúncios, então os sinais de anúncio ficam sempre negados;
      só analytics_storage muda, conforme a escolha feita no banner (guardada no navegador).
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });
      gtag('set', 'ads_data_redaction', true);
      var escolhaSalva = null;
      try {
        escolhaSalva = localStorage.getItem('consentimento_analytics');
      } catch (e) {}
      if (escolhaSalva === 'granted') {
        gtag('consent', 'update', { analytics_storage: 'granted' });
      }
    </script>

    <!-- Google Tag Manager: carrega o contêiner; o GA4 é configurado dentro do GTM -->
    <script is:inline define:vars={{ GTM_ID }}>
      window.dataLayer = window.dataLayer || [];
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', GTM_ID);
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>

    <!-- Cabeçalho fixo: fica visível ao rolar a página (position: sticky) -->
    <header class="site-header">
      <nav class="site-nav" aria-label="Navegação principal">
        <a href="/" class="site-nome">Maximiliano Ferreira</a>
        <span class="site-links">
          <a href="/" aria-current={secao === 'curriculo' ? 'page' : undefined}>Currículo</a>
          <a href="/artigos" aria-current={secao === 'artigos' ? 'page' : undefined}>Artigos</a>
          <slot name="acoes" />
        </span>
      </nav>
    </header>

    <slot />

    <footer class="rodape">
      <a href="/privacidade">Privacidade</a>
      <span aria-hidden="true">·</span>
      <button type="button" class="link-botao" data-abrir-consentimento>Preferências de cookies</button>
    </footer>

    <ConsentBanner />
  </body>
</html>
