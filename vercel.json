{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:caminho*",
      "has": [{ "type": "host", "value": "ferreiraprobr.vercel.app" }],
      "destination": "https://www.ferreira.pro.br/:caminho*",
      "permanent": true
    }
  ]
}
